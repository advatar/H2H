# Single workspace (only), public Slack channels where bot is a member.
SLACK_TEAM_ID=T123456789
SLACK_ALLOWED_CHANNEL_IDS=C123456789
SLACK_BOT_TOKEN=xoxb-REPLACE_ME
SLACK_APP_TOKEN=xapp-REPLACE_ME
# Not required in Bolt Socket Mode, but required for a future signed HTTP receiver.
# SLACK_SIGNING_SECRET=REPLACE_ME

# Optional, explicitly configured OpenAI-compatible summarizer.
# When omitted, summaries are extractive and no third-party API is called.
# The actual content you approve is sent to the configured model endpoint.
# H2H_MODEL_URL=https://your-approved-provider.example/v1/chat/completions
# H2H_MODEL_NAME=your-model-id
# H2H_MODEL_API_KEY=REPLACE_ME

# Test-only local non-TLS model endpoint. Never use outside isolated development.
# H2H_ALLOW_LOCAL_HTTP_MODEL=true

# REQUIRED for durable state (Slack and MCP services)
# DATABASE_URL=postgres://h2h:REPLACE_PASSWORD@127.0.0.1:5432/h2h
# H2H_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
# H2H_DB_TLS=true
# H2H_DB_CA_FILE=/path/to/private/ca.pem

# REQUIRED for remote OAuth MCP service
# H2H_MCP_PUBLIC_URL=https://h2h.example.org/mcp
# H2H_OAUTH_ISSUER=https://issuer.example.org
# H2H_OAUTH_METADATA_URL=https://issuer.example.org/.well-known/oauth-authorization-server
# H2H_MCP_PORT=3000
# H2H_LISTEN_HOST=127.0.0.1

# Admin-only link-user operation (subject and Slack user independently verified)
# H2H_LINK_SUBJECT=OIDC_SUBJECT
# H2H_LINK_SLACK_USER=U123456789
