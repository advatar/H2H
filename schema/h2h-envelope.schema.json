{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/advatar/H2H/blob/main/schema/h2h-envelope.schema.json",
  "title": "H2H 0.1 Envelope",
  "description": "Experimental semantics; validating this schema does NOT authenticate identity, grants or source provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_id",
    "thread_id",
    "kind",
    "sent_at",
    "sender",
    "audience",
    "intent",
    "policy"
  ],
  "properties": {
    "protocol": {
      "const": "h2h/0.1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "thread_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "enum": [
        "brief",
        "assessment",
        "reply_proposal",
        "reply",
        "receipt",
        "revoke"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_id",
        "agent_id"
      ],
      "properties": {
        "human_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "humans",
            "channel"
          ]
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "inform",
            "feedback",
            "decision"
          ]
        },
        "prompt": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "permitted_operations",
        "forwarding",
        "grant_ref",
        "expires_at"
      ],
      "properties": {
        "classification": {
          "enum": [
            "direct",
            "workspace",
            "public"
          ]
        },
        "permitted_operations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "private_interpret",
              "draft_reply",
              "post_reply",
              "forward"
            ]
          }
        },
        "forwarding": {
          "enum": [
            "deny",
            "human_approval"
          ]
        },
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "type"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "responds_to",
            "revokes"
          ]
        }
      }
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "uri",
        "coverage",
        "supplied_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "enum": [
            "full",
            "partial",
            "link_only"
          ]
        },
        "supplied_by": {
          "enum": [
            "human",
            "authorized_connector"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "basis",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "source",
            "inference",
            "unverified"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "source"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "sources"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "claims": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_message_id",
        "stage",
        "at",
        "actor_id"
      ],
      "properties": {
        "target_message_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "accepted_by_relay",
            "delivered_to_agent",
            "interpreted_by_agent",
            "seen_by_human",
            "reply_approved_by_human"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "human_confirmed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "seen_by_human",
                  "reply_approved_by_human"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "required": [
              "human_confirmed"
            ],
            "properties": {
              "human_confirmed": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "brief",
              "assessment",
              "reply_proposal",
              "reply"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "artifact"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "reply_proposal",
              "reply",
              "revoke"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "relation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "receipt"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "receipt"
        ]
      }
    }
  ]
}
